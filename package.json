  "private": true,
  "description": "Discord-integrated Pokemon trading card instant-offer MVP.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
