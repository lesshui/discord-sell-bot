{
  "name": "discord-sell-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord-integrated Pokemon trading card instant-offer MVP.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "bot:dev": "tsx src/bot/index.ts",
    "bot:start": "node dist/bot/index.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.19.3",
    "next": "^14.2.29",
    "next-auth": "^4.24.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.50",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.29",
    "prisma": "^5.22.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
